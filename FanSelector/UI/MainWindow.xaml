<Window x:Class="FanSelector.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Fan Selector"
        Height="620" Width="1000" MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FFF6F6F8"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FF6B6B76" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="MinWidth" Value="80" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="14">

    <!-- Header -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
      <Image x:Name="LogoImage" Height="26" Margin="0,0,12,0" Stretch="Uniform" />
      <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>

    <Border x:Name="BannerBorder" DockPanel.Dock="Top" Visibility="Collapsed"
            Background="#FFFFF9DB" BorderBrush="#FFE8D98A" BorderThickness="1"
            Padding="8,5" Margin="0,0,0,10" Cursor="Hand"
            MouseLeftButtonUp="OnBannerClick">
      <TextBlock x:Name="BannerText" TextWrapping="Wrap" Foreground="#FF6B5A10" />
    </Border>

    <!-- Search bar -->
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#FFDDDDE3" BorderThickness="1"
            Padding="10" Margin="0,0,0,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Fan family"
                   Style="{StaticResource FieldLabel}" />
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="FamilyCombo"
                  DisplayMemberPath="FamilyName" SelectionChanged="OnFamilyChanged" />

        <TextBlock Grid.Row="0" Grid.Column="3" Text="Air flow"
                   Style="{StaticResource FieldLabel}" />
        <TextBox Grid.Row="0" Grid.Column="4" x:Name="AirFlowBox" Width="90" />
        <TextBlock Grid.Row="0" Grid.Column="5" x:Name="AirFlowUnit"
                   Style="{StaticResource FieldLabel}" Margin="6,0,0,0" MinWidth="44" />

        <TextBlock Grid.Row="0" Grid.Column="7" Text="Tolerance"
                   Style="{StaticResource FieldLabel}" />
        <TextBox Grid.Row="0" Grid.Column="8" x:Name="ToleranceBox" Width="46" />
        <TextBlock Grid.Row="0" Grid.Column="9" Text="%" Style="{StaticResource FieldLabel}"
                   Margin="6,0,0,0" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Sort by"
                   Style="{StaticResource FieldLabel}" Margin="0,8,6,0" />
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SortCombo" Margin="0,8,0,0"
                  SelectionChanged="OnSortChanged">
          <ComboBoxItem Content="Closest to the requested duty" IsSelected="True" />
          <ComboBoxItem Content="Lowest SFP / best efficiency" />
          <ComboBoxItem Content="Quietest" />
          <ComboBoxItem Content="Lowest motor power" />
        </ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="3" Text="Pressure"
                   Style="{StaticResource FieldLabel}" Margin="0,8,6,0" />
        <TextBox Grid.Row="1" Grid.Column="4" x:Name="PressureBox" Width="90" Margin="0,8,0,0" />
        <TextBlock Grid.Row="1" Grid.Column="5" x:Name="PressureUnit"
                   Style="{StaticResource FieldLabel}" Margin="6,8,0,0" MinWidth="44" />

        <StackPanel Grid.Row="1" Grid.Column="7" Grid.ColumnSpan="3" Orientation="Horizontal"
                    Margin="0,8,0,0" HorizontalAlignment="Right">
          <Button x:Name="SearchButton" Content="Search" IsDefault="True"
                  Click="OnSearch" Margin="0,0,8,0" />
          <Button x:Name="OptionsButton" Content="Options…" Click="OnOptions" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Footer -->
    <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" x:Name="StatusText" Style="{StaticResource Hint}"
                 VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="InsertButton" Content="Insert fan" Click="OnInsert"
                IsEnabled="False" Margin="0,0,8,0" />
        <Button x:Name="CloseButton" Content="Close" IsCancel="True" />
      </StackPanel>
    </Grid>

    <!-- Results -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="220" />
      </Grid.ColumnDefinitions>

      <DataGrid Grid.Column="0" x:Name="ResultsGrid"
                AutoGenerateColumns="False" IsReadOnly="True"
                SelectionMode="Single" SelectionUnit="FullRow"
                HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                HorizontalGridLinesBrush="#FFE8E8ED"
                BorderBrush="#FFDDDDE3" Background="White"
                AlternatingRowBackground="#FFFAFAFC"
                CanUserResizeRows="False"
                SelectionChanged="OnResultSelected"
                MouseDoubleClick="OnResultDoubleClick" />

      <Border Grid.Column="2" Background="White" BorderBrush="#FFDDDDE3" BorderThickness="1">
        <Image x:Name="PreviewImage" Margin="8" Stretch="Uniform" />
      </Border>
    </Grid>

  </DockPanel>
</Window>
