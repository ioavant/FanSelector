<Window x:Class="FanSelector.UI.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Fan Selector Options"
        Height="680" Width="860" MinHeight="560" MinWidth="740"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FFF6F6F8"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FF6B6B76" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="MinWidth" Value="76" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="14">

    <!-- Header -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
      <Image x:Name="LogoImage" Height="26" Margin="0,0,12,0"
             HorizontalAlignment="Left" Stretch="Uniform" />
      <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                 VerticalAlignment="Center" Text="Fan Selector Options" />
    </StackPanel>

    <!-- Update banner: only ever visible in a brand that checks for updates -->
    <Border x:Name="BannerBorder" DockPanel.Dock="Top" Visibility="Collapsed"
            Background="#FFFFF9DB" BorderBrush="#FFE8D98A" BorderThickness="1"
            Padding="8,5" Margin="0,0,0,10" Cursor="Hand"
            MouseLeftButtonUp="OnBannerClick">
      <TextBlock x:Name="BannerText" TextWrapping="Wrap" Foreground="#FF6B5A10" />
    </Border>

    <!-- Notice, e.g. "no families configured yet" -->
    <Border x:Name="NoticeBorder" DockPanel.Dock="Top" Visibility="Collapsed"
            Background="#FFFFF1E6" BorderBrush="#FFE7C4A0" BorderThickness="1"
            Padding="8,5" Margin="0,0,0,10">
      <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="#FF8A4B10" />
    </Border>

    <!-- Buttons -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton" Content="OK" IsDefault="True" Click="OnOk" Margin="0,0,8,0" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" />
    </StackPanel>

    <TextBlock x:Name="LocationText" DockPanel.Dock="Bottom" Style="{StaticResource Hint}"
               Margin="0,10,0,0" />

    <!-- Search defaults -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#FFDDDDE3" BorderThickness="0,1,0,0"
            Padding="0,10,0,0" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="Default tolerance" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox x:Name="ToleranceBox" Grid.Column="1" Width="60" />
        <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="6,0,0,0" />

        <TextBlock Grid.Column="4" Text="Mounting offset above the picked point"
                   VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox x:Name="OffsetBox" Grid.Column="5" Width="90" />
        <TextBlock x:Name="OffsetUnitText" Grid.Column="6" VerticalAlignment="Center" Margin="6,0,0,0" />
      </Grid>
    </Border>

    <!-- Families and their mapping -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Configured fan families" Style="{StaticResource Section}"
                   Margin="0,0,0,6" />

        <Button DockPanel.Dock="Bottom" x:Name="RemoveButton" Content="Remove selected"
                Click="OnRemoveFamily" Margin="0,8,0,0" HorizontalAlignment="Stretch" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <Button DockPanel.Dock="Right" x:Name="AddButton" Content="Add"
                  Click="OnAddFamily" Margin="6,0,0,0" MinWidth="56" />
          <ComboBox x:Name="AddFamilyBox" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" x:Name="FamilyHint" Style="{StaticResource Hint}"
                   Text="Mechanical Equipment families loaded in this project." />

        <ListBox x:Name="FamilyList" DisplayMemberPath="FamilyName"
                 SelectionChanged="OnFamilySelected" />
      </DockPanel>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel x:Name="MappingPanel">

          <TextBlock x:Name="MappingHeader" Style="{StaticResource Section}" Margin="0,0,0,2"
                     Text="Parameter mapping" />
          <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                     Text="Point each figure at the type parameter of this family that carries it. Only parameters of a fitting kind are listed." />

          <CheckBox x:Name="ShowAllBox" Content="Show every parameter of a compatible storage type"
                    Click="OnShowAllChanged" Margin="0,0,0,10" />

          <!-- One row per quantity, built in code from Quantities.All -->
          <Grid x:Name="MappingGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
          </Grid>

          <TextBlock Text="Extra columns" Style="{StaticResource Section}" />
          <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                     Text="Any other type parameters you want to see beside the results. They are shown only, never filtered on." />

          <DockPanel>
            <Button DockPanel.Dock="Right" x:Name="AddExtraButton" Content="Add"
                    Click="OnAddExtra" Margin="6,0,0,0" MinWidth="56" />
            <ComboBox x:Name="ExtraPicker" DisplayMemberPath="Label" />
          </DockPanel>
          <ListBox x:Name="ExtraList" Height="82" Margin="0,6,0,0" />
          <Button x:Name="RemoveExtraButton" Content="Remove selected column"
                  Click="OnRemoveExtra" Margin="0,6,0,0" HorizontalAlignment="Left" />

          <TextBlock Text="Write air flow onto the placed instance" Style="{StaticResource Section}" />
          <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                     Text="Optional. Only needed by families whose duct connector is driven by an instance override rather than by the type." />
          <!-- Editable on purpose: instance parameters cannot be listed unless the
               project already has an instance of the family, so the name has to
               be typeable. Items are plain names so the text is always the name. -->
          <ComboBox x:Name="InstanceBox" IsEditable="True" />
          <TextBlock x:Name="InstanceHint" Style="{StaticResource Hint}" />

        </StackPanel>
      </ScrollViewer>
    </Grid>

  </DockPanel>
</Window>
